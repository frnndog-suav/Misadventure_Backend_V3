{
  "name": "misadventure_backend",
  "version": "0.1.0",
  "description": "Motor de regras autoritativo do Misadventures",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "validate:content": "nest build && node dist/infra/content/validate-content.cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frnndog-suav/Misadventure_Backend_V3.git"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "@nestjs/common": "^11.2.10",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.10",
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "unplugin-swc": "^2.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  }
}
